#!/usr/bin/dash

cache="/tmp/nchat_display_cache"
#pidfile="/tmp/nchat_display.pid"
load="/tmp/nchat_display_load"

## Check if PID file exists and a process is running with the stored PID
#if [ -f "$pidfile" ]; then
#	pid="$(cat "$pidfile")"
#	if $(kill -0 "$pid" >/dev/null 2>&1) ; then
#		#echo "Another instance of nchat_display is already running. Exiting..."
#		exit 0
#	fi
#fi
#echo "$$" > "$pidfile"

CLOSE () {
	pkill -f 'img_whats_view'
	printf 'no' > "$load"
	exit 0
}

pipe="$(cat)"

case "$pipe" in
	'close')
			CLOSE;
		;;

	'no_photo_available')
		file="$HOME/Backup/Pictures/no_image.png"
		;;

	file:*)
		file="$(printf '%s' "$pipe" | sed 's/^file://')"
		# if the file was deleted from cache, just exit
		if [ ! -f "$file" ]; then
			CLOSE;
		fi
		;;

	text:*)
		text="$(printf '%s' "$pipe" | sed 's/^text://')"
		;;

	*)
		notify 'pipe not formated'
		exit 1
esac

if [ "$text" ]; then
	url="$(printf '%s' "$text" | grep -iE 'www|http' | head -n 1 | sed 's/.*\(www\)/\1/ ; s/.*\(http\)/\1/ ; s/ .*//')"

	case "$url" in

		''|*instagram*)
			CLOSE;
		;;

		*prescricao.cfm*)
			file="$cache/$(printf '%s' "$url" | sed 's|/|_|g ; s/$/.pdf/')"
			if [ ! -f "$file" ]; then
				wget -q "$url" -O "$file"
			fi
			if [ ! -s "$file" ]; then
				notify 'Failed to get prescription!'
				exit 1
			fi
		;;

		*youtube*|*youtu.be*)
			file="$cache/$(printf '%s' "$url" | sed 's|/|_|g ; s/$/.jpg/')"
			if [ ! -f "$file" ]; then
				identifier="$(printf '%s' "$url" | sed 's|.*/|| ; s/?.*//')"
				wget -q -T 5 "https://img.youtube.com/vi/$identifier/maxresdefault.jpg" -O "$file"
			fi
		;;

		*)
			file="$cache/$(printf '%s' "$url" | cut -c -200 | sed 's|/|_|g ; s/$/.jpg/')"
			if [ ! -f "$file" ]; then

				printf 'yes' > "$load"

				#swayimg --appid=img_whats_view --size=600x600 "$HOME/Backup/Pictures/loading_icon.gif" >/dev/null 2>&1 &
#				[ -f "$pidfile" ] && rm "$pidfile"

				notify -t 20 'Getting thumbnail...'
				timeout 20 helium --headless=new --user-agent="Chrome/135.0.0.0" --window-size=600,600 --screenshot="$file" "$url" </dev/null >/dev/null 2>&1

				if [ "$(cat "$load")" = 'no' ]; then
					notify -t 1 'Getting thumbnail: aborted'
					exit 0
				fi

				if [ ! -f "$file" ]; then
#					file="$HOME/Backup/Pictures/no_image.png"
					notify -t 1 'Getting thumbnail: failed'
					exit 1
				else
					notify -t 1 'Getting thumbnail: done!'
				fi

			fi
		;;

	esac
fi

if [ ! -s "$file" ]; then
	notify "Problem to get the file \"$url\""
	exit 1
fi

file_extension="$(printf '%s' "${file##*.}" | tr '[:upper:]' '[:lower:]')"

case "$file_extension" in
	'pdf')
		file_name="$(printf '%s' "$file" | awk -F '/' '{ print $NF }')"

		name="$cache/${file_name}.ppm"
		if [ ! -s "$name" ]; then
			pdftoppm -f 1 -l 1 -r 150 -singlefile "$file" "$cache/$file_name" >/dev/null 2>&1
			if [ ! -s "$name" ]; then
				notify 'Problem to convert the pdf'
				exit 1
			fi
		fi
	;;

	'htm'|'html')
		file_name="$(printf '%s' "$file" | awk -F '/' '{ print $NF }')"
		name="$cache/$(printf '%s' "$file_name" | sed 's/\.html$/\.jpg/ ; s/\.htm$/\.jpg/')"
	
		if [ ! -f "$name" ]; then
			helium --headless --screenshot="$name" --window-size=600,600 "$file"
			if [ ! -s "$name" ]; then
				notify 'Problem to convert the html'
				exit 1
			fi
		fi
	;;

	'f4v'|'mpeg'|'mp4'|'webv'|'webm'|'mpe'|'mov')
		file_name="$(printf '%s' "$file" | awk -F '/' '{ print $NF }')"
		name="$cache/$(printf '%s' "$file_name" | sed 's/\.....$/\.jpg/ ; s/\....$/\.jpg/')"
	
		if [ ! -f "$name" ]; then
			ffmpeg -i "$file" -vframes 1 -q:v 1 "$name" >/dev/null 2>&1
			sleep .1
		fi
	;;

	'jpg'|'jpeg'|'png'|'webp')
		name="$file"
	;;

	'oga'|'zip'|'xlsx')
		CLOSE;
	;;

	*)
		notify "Extension not handled: $file_extension"
		exit 0
	;;

esac

# Open the image
# only if we are still focused on nchat
if [ "$(dwlb -printfocused eDP-1)" = 'chat' ]; then
#	swayimg --execute='swayimg.on_initialized(function() swayimg.title = "chat" end)' --appid=img_whats_view --size=600x600 "$name" >/dev/null 2>&1 &
	swayimg --appid=img_whats_view --size=600x600 "$name" >/dev/null 2>&1 &
	swayimgpid="$!"
else
	CLOSE;
fi

# Close other instances
prev_pid="$(pgrep -f 'img_whats_view' | grep -v "$swayimgpid")"

if [ "$prev_pid" ]; then 
	for pid in $prev_pid ; do
		kill -15 "$pid"
	done
fi

time="$(date +%s)"
printf '%s' "$time" > /tmp/nchat_sleep_time
sleep 6
if [ "$(cat "/tmp/nchat_sleep_time")" = "$time" ]; then
	CLOSE;
fi


#[ -f "$pidfile" ] && rm "$pidfile"

exit 0

